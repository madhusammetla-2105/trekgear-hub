    {
      "name": "Rental JOIN API",
      "item": [
        {
          "name": "Get Rental Details (JOIN)",
          "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/rentals/details", "host": ["{{baseUrl}}"], "path": ["rentals", "details"]}},
          "event": [{"listen": "test", "script": {"exec": ["pm.test(\"Status is 200\", () => {", "  pm.expect(pm.response.code).to.equal(200);", "});", "pm.test(\"Response has trekker_name and tent_name\", () => {", "  const res = pm.response.json();", "  pm.expect(res.rentals[0]).to.have.property('trekker_name');", "  pm.expect(res.rentals[0]).to.have.property('tent_name');", "  pm.expect(res.rentals[0]).to.have.property('tent_size');", "});"]}}]
        }
      ]
    },
