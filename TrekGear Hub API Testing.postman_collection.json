{
  "info": {
    "name": "TrekGear Hub API Testing",
    "description": "Postman collection for TrekGear Hub - Trekking Equipment Rental Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "trekgear-hub"
  },
  "item": [
    {
      "name": "Trekker APIs",
      "item": [
        {
          "name": "Create Trekker",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/trekkers", "host": ["{{baseUrl}}"], "path": ["trekkers"]},
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Rahul Sharma\",\n  \"email\": \"rahul@example.com\",\n  \"phone\": \"9876543210\"\n}"}
          },
          "event": [{"listen": "test", "script": {"exec": ["pm.test(\"Status is 201\", () => {", "  pm.expect(pm.response.code).to.equal(201);", "});"]}}]
        },
        {
          "name": "Get All Trekkers",
          "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/trekkers", "host": ["{{baseUrl}}"], "path": ["trekkers"]}},
          "event": [{"listen": "test", "script": {"exec": ["pm.test(\"Status is 200\", () => {", "  pm.expect(pm.response.code).to.equal(200);", "});"]}}]
        },
        {
          "name": "Get Trekker by ID",
          "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/trekkers/1", "host": ["{{baseUrl}}"], "path": ["trekkers", "1"]}},
          "event": [{"listen": "test", "script": {"exec": ["pm.test(\"Status is 200\", () => {", "  pm.expect(pm.response.code).to.equal(200);", "});"]}}]
        },
        {
          "name": "Update Trekker",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/trekkers/1", "host": ["{{baseUrl}}"], "path": ["trekkers", "1"]},
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Rahul Sharma Updated\",\n  \"email\": \"rahul.updated@example.com\",\n  \"phone\": \"9876543210\"\n}"}
          },
          "event": [{"listen": "test", "script": {"exec": ["pm.test(\"Status is 200\", () => {", "  pm.expect(pm.response.code).to.equal(200);", "});"]}}]
        },
        {
          "name": "Delete Trekker (should fail - has rental history)",
          "request": {"method": "DELETE", "url": {"raw": "{{baseUrl}}/trekkers/1", "host": ["{{baseUrl}}"], "path": ["trekkers", "1"]}},
          "event": [{"listen": "test", "script": {"exec": ["pm.test(\"Status is 409\", () => {", "  pm.expect(pm.response.code).to.equal(409);", "});"]}}]
        }
      ]
    },
